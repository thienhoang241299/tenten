{
  "name": "zh-translator-app",
  "private": true,
  "version": "1.0.0",
  "description": "Ứng dụng Dịch Tiếng Trung AI & Pinyin Độc Lập",
  "author": "Antigravity",
  "main": "main-electron.cjs",
  "scripts": {
    "dev": "vite",
    "start": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "pack": "vite build && npx electron-packager . \"ZH-Translator-AI\" --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "pinyin-pro": "^3.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-packager": "^17.1.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  }
}
